/.sessions

# dependencies
/node_modules
/scraper-service/.venv/
/scraper-service/.scrapling-gmarket-profile/
/scraper-service/app/__pycache__/
*.pyc
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# debug screenshots
*.png
*.jpg
*.jpeg
!public/**
.playwright-mcp/

# env files (can opt-in for committing if needed)
.env*

# local Codex and MCP secrets
.codex/
.mcp.json
.mcp.local.json

# vercel
.vercel

# scratch / 임시 작업 파일
.tmp-*
.tmp/
