# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# sessions (scraper cookies)
/.sessions

# dependencies
/node_modules
/scraper-service/.venv/
/scraper-service/.scrapling-gmarket-profile/
/scraper-service/app/__pycache__/
*.pyc
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# debug screenshots
*.png
*.jpg
*.jpeg
!public/**
.playwright-mcp/

# env files (can opt-in for committing if needed)
.env*

# local Codex and MCP secrets
.codex/
.codex-tmp/
.gjc/
.claude/
.mcp.json
.mcp.local.json
supabase/.temp/

# vercel
.vercel

# scratch / 임시 작업 파일
.tmp-*
.tmp/
.outputs/
outputs/
.omc/
dev-server.log
scraper-service.log

# typescript
*.tsbuildinfo
next-env.d.ts

# 자동화 스크립트 실행 로그
scripts/logs/

# 공공데이터 캐시 — 용량이 커서(수십 MB) 커밋하지 않는다.
# 없으면 스크립트가 알아서 다시 받는다: scripts/mfds-bulk-download.mjs, scripts/ecolife-catalog.mjs
scripts/output/
logs/

# DB 스냅샷 백업 — 용량이 커서(20MB+) 커밋하지 않는다. 복구용 로컬 보관.
backups/
# Hermes 데스크톱 첨부 캐시
.hermes/
# 일회성 임시 산출물
.tmp_*
preview-detail.html

# 브라우저 로그인 프로필 — 쿠키/세션이 들어있어 절대 커밋 금지 (79MB+)
.browser-profiles/
# 일회성 비교 산출물
scripts/seller-code-diffs.json
